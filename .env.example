# Instadeed - Environment Variables
# Copy this to .env and fill in all values

# --- REQUIRED: Authentication ---
JWT_SECRET=change-this-to-a-long-random-string-of-at-least-32-chars

# --- REQUIRED: Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# --- RECOMMENDED: Admin Account ---
ADMIN_EMAIL=admin@instadeed.local
ADMIN_PASSWORD=your-strong-admin-password

# --- RECOMMENDED: Leegality e-Sign ---
LEEGALITY_AUTH_TOKEN=
LEEGALITY_PRIVATE_SALT=
LEEGALITY_BASE_URL=https://sandbox.leegality.com/api
LEEGALITY_PROFILE_ID=

# --- RECOMMENDED: CORS ---
ALLOWED_ORIGINS=https://instadeed.io,https://instadeed.onrender.com

# --- OPTIONAL: PostgreSQL (for production scaling) ---
# DATABASE_URL=postgresql://user:password@host:5432/instadeed

# --- OPTIONAL: Redis (for caching) ---
# REDIS_URL=redis://localhost:6379/0

# --- OPTIONAL: SMTP (for OTP emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@instadeed.io

# --- OPTIONAL: Monitoring ---
LOG_LEVEL=INFO
SENTRY_DSN=
DEBUG=false

# --- OPTIONAL: Demo mode ---
# DEMO_OTP=123456
